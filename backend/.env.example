# Copy this file to .env and fill in the values.

# Required: get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: model and LLM call behaviour
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Optional: upload limits
MAX_UPLOAD_MB=4
MAX_PDF_PAGES=50

# Optional: rate limiting (disabled when the Upstash values are empty)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=3600

# Optional: comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,https://parsemind.vercel.app
